# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is gitignored)

subscription_id = "00000000-0000-0000-0000-000000000000"

# Must match what legacy/bootstrap.sh was run with.
location    = "eastus2"
environment = "dev"

# Step 1: adopt the existing network. Plan should read "N to import, 0 to add/change/destroy".
import_existing   = true
enable_databricks = false

# Step 2: flip this to add the NAT gateway and the VNet-injected workspace.
# enable_databricks = true
